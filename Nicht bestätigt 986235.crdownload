import streamlit as st
import replicate
import os
import requests
from io import BytesIO
from PIL import Image

# Konfiguration des Dashboards
st.set_page_config(page_title="Immobilien CAD-Generator", layout="wide", initial_sidebar_state="expanded")

st.title("📐 Exposé CAD-Generator (ControlNet)")
st.markdown("Dieses Tool nutzt MLSD-Linienerkennung, um alte Grundrisse strukturell zu erhalten und im gewünschten Stil neu zu zeichnen.")

# Sidebar für Einstellungen und API-Key
with st.sidebar:
    st.header("⚙️ Einstellungen")
    api_key = st.text_input("Replicate API-Token:", type="password", help="Erstelle einen kostenlosen Token auf replicate.com")
    
    st.divider()
    
    style_choice = st.selectbox(
        "Zieldesign wählen:",
        ("Exposé Classic (Referenz-Stil)", "Minimalistisch S/W", "Blaupause (Blueprint)")
    )
    
    # Basis-Prompt für die Architektur (aus deinem optimierten Prompt)
    base_prompt = "professional 2D CAD floor plan, top-down orthographic view, clean dark grey walls, empty rooms, highly detailed, perfect 90 degree corners, correct door swings."
    negative_prompt = "text, labels, dimensions, numbers, messy lines, 3d, perspective, shadows, messy artifacts, stamps."
    
    # Prompt-Modifikatoren je nach gewähltem Stil
    if style_choice == "Exposé Classic (Referenz-Stil)":
        style_prompt = "warm wood textures in living rooms, grey tiles in bathroom, subtle minimalist furniture symbols, realistic floor textures."
    elif style_choice == "Minimalistisch S/W":
        style_prompt = "pure black and white, stark contrast, absolute white background, pitch black thick walls, no textures, clean vector style."
    elif style_choice == "Blaupause (Blueprint)":
        style_prompt = "classic architectural blueprint, deep blue background, crisp white lines, technical drawing style."

    final_prompt = f"{base_prompt} {style_prompt}"

# Hauptbereich: Upload und Generierung
uploaded_file = st.file_uploader("Alten Grundriss hochladen (JPG/PNG)", type=["jpg", "png", "jpeg"])

if uploaded_file is not None:
    col1, col2 = st.columns(2)
    
    with col1:
        st.subheader("Originalplan")
        original_image = Image.open(uploaded_file)
        st.image(original_image, use_container_width=True)

    with col2:
        st.subheader("Neuer CAD-Plan")
        
        if not api_key:
            st.warning("Bitte gib links in der Sidebar deinen Replicate API-Token ein, um den Server zu starten.")
        else:
            if st.button("Plan jetzt neu zeichnen", type="primary"):
                os.environ["REPLICATE_API_TOKEN"] = api_key
                
                with st.spinner(f"Verarbeite Bild im Stil '{style_choice}'... Das dauert ca. 15-30 Sekunden."):
                    try:
                        # API-Call an Replicate (ControlNet MLSD für Architektur)
                        output = replicate.run(
                            "jagilley/controlnet-hough:854e87270c1a024da23db28399589d81d227a81062638843236e3995204439c2",
                            input={
                                "image": uploaded_file,
                                "prompt": final_prompt,
                                "negative_prompt": negative_prompt,
                                "num_inference_steps": 25,
                                "image_resolution": 768, # Hohe Auflösung für saubere Linien
                                "guidance_scale": 9.0
                            }
                        )
                        
                        # Output[1] enthält das finale Bild (Output[0] ist oft die extrahierte Linien-Maske)
                        result_url = output[1] if isinstance(output, list) else output
                        
                        # Bild herunterladen und anzeigen
                        response = requests.get(result_url)
                        result_img = Image.open(BytesIO(response.content))
                        
                        st.image(result_img, use_container_width=True)
                        st.success("Generierung erfolgreich!")
                        
                        # Download-Button für das fertige Exposé-Bild
                        buf = BytesIO()
                        result_img.save(buf, format="PNG")
                        byte_im = buf.getvalue()
                        
                        st.download_button(
                            label="Fertigen Plan herunterladen",
                            data=byte_im,
                            file_name="Expose_Plan_Clean.png",
                            mime="image/png"
                        )
                        
                    except Exception as e:
                        st.error(f"Fehler bei der API-Anbindung. Bitte prüfe deinen Token. Details: {e}")